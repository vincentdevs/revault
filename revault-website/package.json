{
  "name": "revault-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node serve.mjs",
    "deploy": "node build.mjs && wrangler deploy",
    "preview": "wrangler dev",
    "build:v2": "THEME=v2 node build.mjs",
    "deploy:v2": "THEME=v2 node build.mjs && wrangler deploy --name revault-v2 --assets dist-v2",
    "db:setup": "wrangler d1 execute revault-leads --remote --file worker/schema.sql",
    "leads": "wrangler d1 execute revault-leads --remote --command \"SELECT id, ts, lang, name, email, company, role, notified FROM leads ORDER BY id DESC LIMIT 50\""
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/red-hat-display": "^5.0.0",
    "@fontsource-variable/red-hat-text": "^5.0.0",
    "@fontsource/russo-one": "^5.3.0",
    "opentype.js": "^2.0.0",
    "wrangler": "^4.160.1"
  }
}
